# Frontend public env vars for Vite.
# Copy this file to .env for local development and replace placeholders.
# In Vercel, configure these in Project Settings > Environment Variables.

VITE_CESIUM_TOKEN="REPLACE_WITH_CESIUM_TOKEN"
VITE_OPEN_ROUTE_SERVICE_KEY="REPLACE_WITH_OPEN_ROUTE_SERVICE_KEY"
VITE_GOOGLE_APPS_SCRIPT_URL="REPLACE_WITH_GOOGLE_APPS_SCRIPT_URL"

# Optional: the app falls back to the production Worker if this is omitted.
VITE_MAPVISOR_API_URL="https://mapvisor-api.mapvisor-nikoll.workers.dev"

# Optional: only configure if you enable websocket features.
VITE_SOCKET_BASE_URL=""

# Backend/R2 values are not used by the Vite frontend directly.
# Configure these in Cloudflare Worker/Vercel server environments, not in client code.
R2_PUBLIC_BASE_URL="https://REPLACE_WITH_PUBLIC_R2_DOMAIN"
R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"
R2_ACCOUNT_ID="REPLACE_WITH_R2_ACCOUNT_ID"
R2_BUCKET_NAME="REPLACE_WITH_R2_BUCKET_NAME"
